[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
depth 40
multiclock off

[engines]
smtbmc z3

[script]
# Uses the real, unmodified ext_loader.sv from src/ -- no RTL edits for
# formal. -D ASSERT_ON enables the module's existing `ifdef ASSERT_ON` block
# (p_write_only_when_active, p_force_reset_mirrors_pin, p_addr_in_bounds).
# See scratchpad.sby for why read_slang (not read_verilog) is required.
#
# SCRATCHPAD_WORDS is knocked down from the RTL default (16) purely to keep
# BMC state space tractable -- same reasoning as scratchpad.sby.
plugin -i slang
read_slang --top ext_loader -D ASSERT_ON ext_loader.sv
chparam -set SCRATCHPAD_WORDS 4 ext_loader
prep -top ext_loader

[files]
ext_loader.sv
